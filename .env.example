# Flask Secret Key
SECRET_KEY=change-this-to-a-secure-random-key

# Direct Email Delivery Settings (Optional SMTP)
# If provided, Flask uses Gmail/Outlook SMTP to send messages directly to your inbox.
# If omitted, Flask logs inquiries safely to messages.log.
RECIPIENT_EMAIL=ralphngirazi@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
